// Prisma Schema for AI Mosaic Floor & Surface Design Studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  passwordHash String
  role         String         @default("USER") // SUPER_ADMIN, ADMIN, CONTENT_EDITOR, USER
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  generations  AIGeneration[]
  leads        Lead[]
  auditLogs    AuditLog[]
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String
  category       String
  sampleImageUrl String
  pricePerSqFt   Float
  specs          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  generations    AIGeneration[]
  leads          Lead[]
}

model AIGeneration {
  id                 String      @id @default(cuid())
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail          String?
  prompt             String
  placement          String
  inputImageUrl      String?
  maskUrl            String?
  resultImageUrl     String
  productId          String?
  product            Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  referenceProductId String?
  status             String      @default("COMPLETED")
  createdAt          DateTime    @default(now())
  leads              Lead[]
}

model Page {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  templateType  String
  heading       String
  bodyText      String
  heroImageUrl  String?
  secondaryText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  generationId   String?
  generation     AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String?
  spaceType      String        @default("General Surface")
  roomDimensions String?
  designImageUrl String?
  message        String
  status         String        @default("NEW") // NEW, CONTACTED, IN_PROGRESS, CLOSED
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  adminId        String?
  user           User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  targetResource String?
  resourceId     String?
  metadata       String?
  createdAt      DateTime @default(now())
}

model FinderStep {
  id            String         @id @default(cuid())
  stepNumber    Int            @unique // 1, 2, 3, 4, 5
  key           String         @unique // style, shape, color, space, result
  title         String
  highlightWord String?
  subtitle      String?
  description   String
  order         Int            @default(0)
  options       FinderOption[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt @default(now())
}

model FinderOption {
  id           String      @id @default(cuid())
  stepId       String
  step         FinderStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label        String
  value        String
  imageUrl     String?
  colorHex     String?
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt @default(now())
}

