// Prisma Schema for AI Mosaic Floor & Surface Design Studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  passwordHash String
  role         String         @default("CONTENT_EDITOR") // ADMIN, CONTENT_EDITOR
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  generations  AIGeneration[]
  leads        Lead[]
  auditLogs    AuditLog[]
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String
  category       String
  sampleImageUrl String
  pricePerSqFt   Float
  specs          String
  isTrashed      Boolean        @default(false)
  trashedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  generations    AIGeneration[]
  leads          Lead[]
}

model AIGeneration {
  id                 String      @id @default(cuid())
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail          String?
  prompt             String
  placement          String
  inputImageUrl      String?
  maskUrl            String?
  resultImageUrl     String
  productId          String?
  product            Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  referenceProductId String?
  status             String      @default("COMPLETED")
  isTrashed          Boolean     @default(false)
  trashedAt          DateTime?
  createdAt          DateTime    @default(now())
  leads              Lead[]
}

model Page {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  templateType       String
  heading            String
  bodyText           String
  heroImageUrl       String?
  secondaryText      String?
  featuredProductIds String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Lead {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  generationId   String?
  generation     AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String?
  spaceType      String        @default("General Surface")
  roomDimensions String?
  designImageUrl String?
  message        String
  status         String        @default("NEW") // NEW, CONTACTED, IN_PROGRESS, CLOSED
  assignedToId   String?
  adminNotes     String?
  quoteAmount    Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  adminId        String?
  user           User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  targetResource String?
  resourceId     String?
  metadata       String?
  createdAt      DateTime @default(now())
}

model FinderStep {
  id            String         @id @default(cuid())
  stepNumber    Int            @unique // 1, 2, 3, 4, 5
  key           String         @unique // style, shape, color, space, result
  title         String
  highlightWord String?
  subtitle      String?
  description        String
  order              Int            @default(0)
  featuredProductIds String?
  options            FinderOption[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt @default(now())
}

model FinderOption {
  id           String      @id @default(cuid())
  stepId       String
  step         FinderStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label        String
  value        String
  imageUrl     String?
  colorHex     String?
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt @default(now())
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int      // Compressed size in bytes
  originalSize Int      // Original size in bytes
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
}

model FinderResult {
  id              String   @id @default(cuid())
  userEmail       String?
  style           String
  shape           String
  color           String
  space           String
  generatedPrompt String
  createdAt       DateTime @default(now())
}

model SiteAppearance {
  id                 String   @id @default("default")
  headerBrandName    String   @default("MEC AI MOSAIC")
  headerTagline      String   @default("Bespoke Surface Studio")
  headerLogoUrl      String?
  headerMenuJson     String   @default("[{\"label\":\"Customize your space\",\"url\":\"/\"},{\"label\":\"Imagine from scratch\",\"url\":\"/from-scratch\"},{\"label\":\"Find your aesthetic\",\"url\":\"/finder\"},{\"label\":\"Contact Us\",\"url\":\"https://zakiahmarble.com/contact-us/\",\"external\":true}]")

  footerBrandName    String   @default("MEC AI MOSAIC STUDIO")
  footerDescription  String   @default("Pioneering luxury architectural surface design with AI-powered inpainting, custom waterjet mesh manufacturing, and Italian marble artistry.")
  footerLogoUrl      String?
  footerCopyright    String   @default("© 2026 MEC Artworks Studio. All Rights Reserved.")
  footerContactEmail String?  @default("concierge@mecartworks.com")
  footerContactPhone String?  @default("+1 (800) 555-MOSAIC")
  footerAddress      String?  @default("Carrara, Italy & NY, USA")
  footerLinksJson    String   @default("[{\"label\":\"Customize your space\",\"url\":\"/\"},{\"label\":\"Imagine from scratch\",\"url\":\"/from-scratch\"},{\"label\":\"Find your aesthetic\",\"url\":\"/finder\"},{\"label\":\"Contact Us\",\"url\":\"https://zakiahmarble.com/contact-us/\",\"external\":true}]")
  socialLinksJson    String?  @default("{\"instagram\":\"https://instagram.com\",\"pinterest\":\"https://pinterest.com\",\"linkedin\":\"https://linkedin.com\"}")

  updatedAt          DateTime @updatedAt @default(now())
}


